{
  "name": "haunted-geocities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "bun test ./test/",
    "test:e2e": "vite build --mode e2e && playwright test",
    "screenshots": "vite build --mode e2e && playwright test --config playwright.screenshots.config.ts",
    "ingest:trackers": "bun scripts/ingest-trackers.ts",
    "docker:test": "docker build --progress=plain -t haunted-geocities:test .",
    "package": "vite build && bun scripts/package.ts",
    "fixtures": "bun scripts/fixture-server.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.7",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
